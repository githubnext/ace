				"@earendil-works/pi-durable": "1.0.0"
			},
			"bun": {
				"@types/bun": "1.3.14"
			},
			"ui": {
				"@base-ui/react": "1.4.1",
				"@chenglou/pretext": "0.0.6",
				"@emoji-mart/data": "1.2.1",
				"@fontsource-variable/inter": "5.2.8",
				"@pierre/diffs": "1.2.10",
				"@pierre/trees": "1.0.0-beta.4",
				"@shikijs/langs": "4.0.2",
