				"@types/react-dom": "19.2.3",
				"@webgpu/types": "0.1.69",
				"class-variance-authority": "0.7.1",
				"clsx": "2.1.1",
				"comark": "0.3.2",
				"emoji-mart": "5.6.0",
				"fuzzysort": "3.1.0",
				"lucide-react": "1.48.0",
				"lucide-static": "1.48.0",
				"markdown-it": "14.1.1",
				"motion": "12.23.24",
				"prosemirror-commands": "1.7.1",
				"prosemirror-highlight": "0.15.1",
				"prosemirror-history": "1.5.0",
				"prosemirror-inputrules": "1.5.1",
				"prosemirror-keymap": "1.2.3",
				"prosemirror-markdown": "1.13.4",
				"prosemirror-model": "1.25.4",
				"prosemirror-schema-list": "1.5.1",
				"prosemirror-state": "1.4.4",
				"prosemirror-view": "1.41.8",
				"react": "19.2.4",
				"react-dom": "19.2.4",
				"shadcn": "4.5.0",
				"shiki": "4.0.2",
				"sonner": "2.0.7",
				"tailwind-merge": "3.5.0",
				"tailwindcss": "4.3.0",
				"tw-animate-css": "1.4.0",
				"vite": "7.3.1",
				"@vitejs/plugin-react": "5.1.4",
				"@xterm/addon-fit": "0.11.0",
				"@xterm/xterm": "6.0.0",
				"@tailwindcss/vite": "4.3.0"
			},
			"desktop": {
				"@githubnext/desktop-tools": "github:githubnext/desktop-tools#8efe67fbd38ed293c8e76778f01814b3bd67c5db",
				"electrobun": "1.18.1",
				"@types/three": "0.165.0"
			}
		}
	},
	"scripts": {
		"ace": "bun apps/host/src/cli.ts",
		"ci": "dprint check && bun run lint",
		"fix": "dprint fmt && bun run lint --fix",
		"lint": "git ls-files -z '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs' | xargs -0 oxlint",
		"types": "bun --filter '*' types",
		"app": "bun --filter @ace/app",
		"desktop": "bun --filter @ace/desktop"
	},
	"devDependencies": {
		"@typescript/native-preview": "7.0.0-dev.20260304.1",
		"dprint": "0.50.2",
		"oxlint": "1.51.0"
	},
	"patchedDependencies": {
		"@base-ui/react@1.4.1": "patches/@base-ui%2Freact@1.4.1.patch"
	}
}
