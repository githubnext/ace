{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ace-compute-pilot",
	"main": "index.ts",
	"compatibility_date": "2026-10-15",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{ "name": "CHANNEL", "class_name": "HostedChannel" },
			{ "name": "COMPUTE", "class_name": "Compute" },
			{ "name": "Sandbox", "class_name": "Sandbox" },
		],
	},
	"containers": [{
		"class_name": "Sandbox",
		"instance_type": "standard-1",
		"image": "./Dockerfile",
	}],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["HostedChannel", "Compute"] },
		{ "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
	],
	"observability": { "enabled": true },
}
